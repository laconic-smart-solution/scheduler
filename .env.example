SCHEDULER_PORT=8010

SPRING_DATASOURCE_URL=jdbc:oracle:thin:@//192.168.0.131:1521/LACONIC
SPRING_DATASOURCE_USERNAME=LCN_SCHEDULER
SPRING_DATASOURCE_PASSWORD=LCN_SCHEDULER

# Feature 4 — poll wake
SCHEDULER_POLL_ENABLED=true
SCHEDULER_POLL_INTERVAL_MS=5000

# Feature 8 — retry + reaper
SCHEDULER_RETRY_BASE_DELAY_MS=60000
SCHEDULER_RETRY_MULTIPLIER=2.0
SCHEDULER_RETRY_MAX_DELAY_MS=3600000
SCHEDULER_REAPER_ENABLED=true
SCHEDULER_REAPER_STALE_AFTER_MS=300000
SCHEDULER_REAPER_BATCH_SIZE=50

# Feature 9 — health
SCHEDULER_HEALTH_POLL_STALE_MULTIPLIER=3
